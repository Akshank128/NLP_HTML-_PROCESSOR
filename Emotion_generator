<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NLP Insights: AI Sentiment & Text Summarization Engine</title>
  <style>
    :root {
      --bg: #0b0f19;
      --card-bg: rgba(22, 30, 49, 0.75);
      --border: #23314e;
      --primary: #6366f1;
      --primary-light: #818cf8;
      --accent-green: #10b981;
      --accent-red: #f43f5e;
      --accent-yellow: #f59e0b;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background: radial-gradient(circle at 10% 20%, #1e1b4b 0%, #0b0f19 80%);
      color: var(--text);
      min-height: 100vh;
      padding: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    header {
      text-align: center;
      margin-bottom: 24px;
      max-width: 900px;
    }

    .badge {
      display: inline-block;
      padding: 4px 14px;
      border-radius: 9999px;
      background: rgba(99, 102, 241, 0.18);
      color: var(--primary-light);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 8px;
      border: 1px solid rgba(99, 102, 241, 0.35);
    }

    h1 {
      font-size: 2.2rem;
      font-weight: 800;
      background: linear-gradient(135deg, #fff 40%, #818cf8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 6px;
    }

    p.subtitle {
      color: var(--text-muted);
      font-size: 0.98rem;
    }

    .layout {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 24px;
      max-width: 1200px;
      width: 100%;
    }

    @media (max-width: 900px) {
      .layout {
        grid-template-columns: 1fr;
      }
    }

    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 22px;
      backdrop-filter: blur(14px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    }

    .section-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: #e2e8f0;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .sample-btns {
      display: flex;
      gap: 8px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .sample-btn {
      background: #1e293b;
      border: 1px solid var(--border);
      color: #cbd5e1;
      padding: 5px 10px;
      border-radius: 6px;
      font-size: 0.78rem;
      cursor: pointer;
      transition: all 0.2s;
    }

    .sample-btn:hover {
      background: #334155;
      color: #fff;
    }

    textarea {
      width: 100%;
      height: 190px;
      background: #080d1a;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px;
      color: #f8fafc;
      font-size: 0.92rem;
      line-height: 1.6;
      resize: vertical;
      outline: none;
      transition: border-color 0.2s;
    }

    textarea:focus {
      border-color: var(--primary);
    }

    .btn-analyze {
      width: 100%;
      margin-top: 12px;
      padding: 12px;
      background: linear-gradient(135deg, #4f46e5, #6366f1);
      color: #fff;
      font-weight: 700;
      font-size: 0.95rem;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: transform 0.15s, opacity 0.2s;
    }

    .btn-analyze:hover {
      opacity: 0.95;
      transform: translateY(-1px);
    }

    /* Summary & Linguistics Grid */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 16px;
    }

    .stat-chip {
      background: #0d1527;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px;
      text-align: center;
    }

    .stat-chip .val {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--primary-light);
      font-family: monospace;
    }

    .stat-chip .lbl {
      font-size: 0.72rem;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-top: 2px;
    }

    /* Sentiment Meter */
    .sentiment-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #090e1a;
      border: 1px solid var(--border);
      padding: 16px 20px;
      border-radius: 12px;
      margin-bottom: 20px;
    }

    .sentiment-tag {
      font-size: 1.3rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .sentiment-score {
      font-family: monospace;
      font-size: 1.5rem;
      font-weight: 900;
    }

    /* Emotion Bars */
    .emotion-grid {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 20px;
    }

    .emotion-row {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.85rem;
    }

    .emotion-name {
      width: 70px;
      color: #cbd5e1;
      font-weight: 600;
    }

    .emotion-bar-bg {
      flex: 1;
      height: 9px;
      background: #0d1527;
      border-radius: 5px;
      overflow: hidden;
    }

    .emotion-bar-fill {
      height: 100%;
      border-radius: 5px;
      transition: width 0.4s ease;
    }

    .emotion-pct {
      width: 45px;
      text-align: right;
      font-family: monospace;
      color: var(--text-muted);
    }

    /* Extractive Summary Box */
    .summary-box {
      background: #090e1a;
      border: 1px solid var(--border);
      border-left: 4px solid var(--primary);
      border-radius: 8px;
      padding: 14px;
      font-size: 0.88rem;
      line-height: 1.6;
      color: #e2e8f0;
      margin-bottom: 20px;
      min-height: 60px;
    }

    /* Keywords */
    .keywords-flex {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .keyword-tag {
      background: rgba(99, 102, 241, 0.15);
      border: 1px solid rgba(99, 102, 241, 0.35);
      color: #c7d2fe;
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 0.8rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .keyword-weight {
      color: var(--primary-light);
      font-family: monospace;
      font-size: 0.75rem;
    }

    /* Interview Pitch footer */
    .interview-notes {
      margin-top: 24px;
      max-width: 1200px;
      width: 100%;
      background: rgba(15, 23, 42, 0.9);
      border: 1px dashed #6366f1;
      border-radius: 12px;
      padding: 18px 24px;
    }

    .interview-notes h3 {
      color: var(--primary-light);
      margin-bottom: 8px;
      font-size: 1.1rem;
    }

    .interview-notes ul {
      margin-left: 20px;
      color: #cbd5e1;
      font-size: 0.92rem;
      line-height: 1.6;
    }
  </style>
</head>
<body>

  <header>
    <div class="badge">CSE AI Portfolio Project #2</div>
    <h1>NLP Sentiment & Text Summarization Engine</h1>
    <p class="subtitle">Client-Side Natural Language Processing: VADER-style Valence Scoring, TF Extractive Summarization & Emotion Classification</p>
  </header>

  <div class="layout">
    <!-- Input Card -->
    <div class="card">
      <div class="section-title">
        <span>Input Corpus</span>
      </div>

      <div class="sample-btns">
        <button class="sample-btn" onclick="loadSample('tech')">Tech Product Review</button>
        <button class="sample-btn" onclick="loadSample('complaint')">Customer Support Issue</button>
        <button class="sample-btn" onclick="loadSample('ai')">AI Research Abstract</button>
      </div>

      <textarea id="inputText" placeholder="Paste reviews, articles, customer feedback, or type any sentence here..."></textarea>
      
      <button class="btn-analyze" onclick="runAnalysis()">Run NLP Analysis Engine</button>

      <div class="stats-row">
        <div class="stat-chip">
          <div class="val" id="wordCount">0</div>
          <div class="lbl">Words</div>
        </div>
        <div class="stat-chip">
          <div class="val" id="sentenceCount">0</div>
          <div class="lbl">Sentences</div>
        </div>
        <div class="stat-chip">
          <div class="val" id="lexDiv">0.00</div>
          <div class="lbl">Lexical Diversity</div>
        </div>
        <div class="stat-chip">
          <div class="val" id="readTime">0s</div>
          <div class="lbl">Read Time</div>
        </div>
      </div>
    </div>

    <!-- Output Analysis Card -->
    <div class="card">
      <div class="section-title">
        <span>Sentiment Analysis</span>
        <span style="font-size:0.75rem; color: var(--text-muted); font-weight: normal;">Range: [-1.0, +1.0]</span>
      </div>

      <div class="sentiment-banner">
        <div class="sentiment-tag" id="sentimentTag">
          <span>⚪ Neutral</span>
        </div>
        <div class="sentiment-score" id="sentimentScore">0.00</div>
      </div>

      <div class="section-title">Emotion Distribution</div>
      <div class="emotion-grid">
        <div class="emotion-row">
          <div class="emotion-name">Joy</div>
          <div class="emotion-bar-bg"><div id="barJoy" class="emotion-bar-fill" style="width:0%; background:#10b981;"></div></div>
          <div class="emotion-pct" id="pctJoy">0%</div>
        </div>
        <div class="emotion-row">
          <div class="emotion-name">Anger</div>
          <div class="emotion-bar-bg"><div id="barAnger" class="emotion-bar-fill" style="width:0%; background:#f43f5e;"></div></div>
          <div class="emotion-pct" id="pctAnger">0%</div>
        </div>
        <div class="emotion-row">
          <div class="emotion-name">Sadness</div>
          <div class="emotion-bar-bg"><div id="barSadness" class="emotion-bar-fill" style="width:0%; background:#60a5fa;"></div></div>
          <div class="emotion-pct" id="pctSadness">0%</div>
        </div>
        <div class="emotion-row">
          <div class="emotion-name">Fear</div>
          <div class="emotion-bar-bg"><div id="barFear" class="emotion-bar-fill" style="width:0%; background:#c084fc;"></div></div>
          <div class="emotion-pct" id="pctFear">0%</div>
        </div>
        <div class="emotion-row">
          <div class="emotion-name">Surprise</div>
          <div class="emotion-bar-bg"><div id="barSurprise" class="emotion-bar-fill" style="width:0%; background:#f59e0b;"></div></div>
          <div class="emotion-pct" id="pctSurprise">0%</div>
        </div>
      </div>

      <div class="section-title">Extractive AI Summary (Top Salient Sentence)</div>
      <div class="summary-box" id="summaryText">
        Run analysis to generate an automated extractive summary.
      </div>

      <div class="section-title">Key Salient Terms (TF Frequency)</div>
      <div class="keywords-flex" id="keywordsList">
        <span style="color:var(--text-muted); font-size:0.85rem;">No text analyzed yet.</span>
      </div>
    </div>
  </div>

  <div class="interview-notes">
    <h3>💡 Quick Interview Pitch (Say this in your interview!)</h3>
    <ul>
      <li><strong>Core Pipeline:</strong> "This application implements an end-to-end NLP pipeline running entirely client-side without external API bottlenecks."</li>
      <li><strong>Lexicon & Valence Scoring:</strong> "For sentiment classification, it tokenizes input into unigrams/bigrams, accounts for booster words ('very', 'extremely') and negations ('not', 'hardly'), computing a normalized compound valence score."</li>
      <li><strong>Extractive Summarization:</strong> "It builds sentence embeddings based on Term Frequency (TF) salience matrices, scoring sentences to extract the most representative informational unit."</li>
      <li><strong>Linguistic Metrics:</strong> "Calculates Type-Token Ratio (Lexical Diversity) and reading heuristics for corpus analysis."</li>
    </ul>
  </div>

  <script>
    // Stop words dictionary for NLP tokenization
    const STOP_WORDS = new Set([
      "a", "about", "above", "after", "again", "against", "all", "am", "an", "and", "any", "are", "aren't",
      "as", "at", "be", "because", "been", "before", "being", "below", "between", "both", "but", "by", "can't",
      "cannot", "could", "did", "do", "does", "doing", "don't", "down", "during", "each", "few", "for",
      "from", "further", "had", "has", "have", "having", "he", "he'd", "he'll", "he's", "her", "here",
      "hers", "herself", "him", "himself", "his", "how", "i", "i'd", "i'll", "i'm", "i've", "if", "in",
      "into", "is", "isn't", "it", "it's", "its", "itself", "let's", "me", "more", "most", "my", "myself",
      "no", "nor", "not", "of", "off", "on", "once", "only", "or", "other", "ought", "our", "ours", "ourselves",
      "out", "over", "own", "same", "shan't", "she", "should", "so", "some", "such", "than", "that", "the",
      "their", "theirs", "them", "themselves", "then", "there", "these", "they", "this", "those", "through",
      "to", "too", "under", "until", "up", "very", "was", "wasn't", "we", "were", "what", "when", "where",
      "which", "while", "who", "whom", "why", "with", "won't", "would", "you", "your", "yours"
    ]);

    // Valence lexicon dictionary (VADER-inspired weights)
    const LEXICON = {
      // Positive
      "good": 1.9, "great": 3.1, "excellent": 3.4, "amazing": 3.5, "love": 3.2, "loved": 3.2,
      "best": 3.2, "fast": 1.6, "smooth": 1.8, "perfect": 3.5, "impressive": 2.8, "brilliant": 3.4,
      "helpful": 2.0, "superb": 3.3, "recommend": 2.2, "happy": 2.7, "clean": 1.5, "innovative": 2.5,
      "breakthrough": 3.0, "efficient": 2.1, "outstanding": 3.6, "flawless": 3.2, "enjoy": 2.2,
      
      // Negative
      "bad": -2.5, "terrible": -3.4, "awful": -3.5, "slow": -1.8, "horrible": -3.6, "waste": -2.8,
      "bug": -1.8, "crash": -2.6, "crashed": -2.6, "fail": -2.5, "failed": -2.5, "disappointing": -2.8,
      "disappointed": -2.8, "worst": -3.5, "hate": -3.1, "broken": -2.7, "error": -2.0, "useless": -3.2,
      "poor": -2.2, "frustrating": -2.7, "expensive": -1.4, "regret": -2.6, "lag": -1.6, "flaw": -2.1
    };

    // Emotion lexicons
    const EMOTIONS = {
      joy: ["happy", "great", "love", "amazing", "excellent", "enjoy", "best", "brilliant", "delighted", "superb"],
      anger: ["hate", "horrible", "terrible", "angry", "furious", "annoyed", "frustrating", "waste", "scam"],
      sadness: ["sad", "disappointed", "regret", "depressed", "loss", "grief", "unfortunately", "down"],
      fear: ["scared", "fear", "worried", "risky", "danger", "panic", "threat", "vulnerable", "warning"],
      surprise: ["unexpected", "surprising", "shocking", "astonishing", "remarkable", "wow", "suddenly", "breakthrough"]
    };

    const SAMPLES = {
      tech: "This new AI smartphone is absolutely brilliant and astonishingly fast! The battery life easily lasts over two full days, and the camera delivers stunning, crisp pictures even in low light. I loved the clean UI design and smooth transitions. I highly recommend it to anyone seeking premium quality.",
      complaint: "I am extremely disappointed and frustrated with the customer support service. The application crashed four times within one hour and deleted my unsaved files. It is an awful waste of money, slow response time, and completely broken. Terrible experience!",
      ai: "Recent breakthroughs in deep learning and self-attention transformers have revolutionized natural language understanding. By optimizing cross-entropy loss over large-scale unstructured corpora, these neural models capture long-range contextual dependencies and demonstrate impressive reasoning capabilities across zero-shot multimodal benchmarks."
    };

    function loadSample(key) {
      document.getElementById('inputText').value = SAMPLES[key];
      runAnalysis();
    }

    function tokenizeWords(text) {
      return text.toLowerCase().match(/\b[a-z0-9']+\b/g) || [];
    }

    function tokenizeSentences(text) {
      return text.match(/[^.!?]+[.!?]+(\s|$)|[^.!?]+$/g) || [text];
    }

    function runAnalysis() {
      const text = document.getElementById('inputText').value.trim();
      if (!text) return;

      const words = tokenizeWords(text);
      const sentences = tokenizeSentences(text).map(s => s.trim()).filter(s => s.length > 0);

      // 1. Text Metrics
      document.getElementById('wordCount').innerText = words.length;
      document.getElementById('sentenceCount').innerText = sentences.length;
      const uniqueWords = new Set(words);
      const lexicalDiversity = words.length > 0 ? (uniqueWords.size / words.length).toFixed(2) : "0.00";
      document.getElementById('lexDiv').innerText = lexicalDiversity;
      const readingSeconds = Math.max(1, Math.round((words.length / 200) * 60));
      document.getElementById('readTime').innerText = readingSeconds + 's';

      // 2. Valence Sentiment Analysis (VADER style with negations & boosters)
      let scoreSum = 0;
      let matchedCount = 0;
      const boosters = new Set(["very", "extremely", "incredibly", "super", "really", "so"]);
      const negations = new Set(["not", "never", "no", "hardly", "barely", "isn't", "wasn't", "don't"]);

      for (let i = 0; i < words.length; i++) {
        const w = words[i];
        if (LEXICON[w]) {
          let val = LEXICON[w];
          // Check preceding token for negation or booster
          if (i > 0) {
            const prev = words[i - 1];
            if (boosters.has(prev)) val *= 1.4;
            if (negations.has(prev)) val *= -1.0;
          }
          scoreSum += val;
          matchedCount++;
        }
      }

      // Normalized Compound Score: x / sqrt(x^2 + alpha)
      let compoundScore = matchedCount === 0 ? 0 : scoreSum / Math.sqrt(scoreSum * scoreSum + 15);
      compoundScore = Math.max(-1.0, Math.min(1.0, compoundScore));

      const scoreEl = document.getElementById('sentimentScore');
      const tagEl = document.getElementById('sentimentTag');
      scoreEl.innerText = (compoundScore >= 0 ? "+" : "") + compoundScore.toFixed(2);

      if (compoundScore > 0.15) {
        tagEl.innerHTML = `<span style="color:var(--accent-green)">🟢 Positive Sentiment</span>`;
        scoreEl.style.color = 'var(--accent-green)';
      } else if (compoundScore < -0.15) {
        tagEl.innerHTML = `<span style="color:var(--accent-red)">🔴 Negative Sentiment</span>`;
        scoreEl.style.color = 'var(--accent-red)';
      } else {
        tagEl.innerHTML = `<span style="color:var(--accent-yellow)">🟡 Neutral / Objective</span>`;
        scoreEl.style.color = 'var(--accent-yellow)';
      }

      // 3. Emotion Analysis
      let emotionCounts = { joy: 0, anger: 0, sadness: 0, fear: 0, surprise: 0 };
      let totalEmotionMatches = 0;

      for (let w of words) {
        for (let emo in EMOTIONS) {
          if (EMOTIONS[emo].includes(w)) {
            emotionCounts[emo]++;
            totalEmotionMatches++;
          }
        }
      }

      for (let emo in emotionCounts) {
        const pct = totalEmotionMatches === 0 ? 0 : Math.round((emotionCounts[emo] / totalEmotionMatches) * 100);
        const capitalized = emo.charAt(0).toUpperCase() + emo.slice(1);
        document.getElementById(`bar${capitalized}`).style.width = pct + '%';
        document.getElementById(`pct${capitalized}`).innerText = pct + '%';
      }

      // 4. Extractive Text Summarization (TF sentence scoring)
      const wordFreq = {};
      for (let w of words) {
        if (!STOP_WORDS.has(w) && w.length > 2) {
          wordFreq[w] = (wordFreq[w] || 0) + 1;
        }
      }

      let bestSentence = sentences[0] || "";
      let highestScore = -1;

      for (let s of sentences) {
        const sWords = tokenizeWords(s);
        let sScore = 0;
        for (let sw of sWords) {
          if (wordFreq[sw]) sScore += wordFreq[sw];
        }
        // Normalize by sentence length to avoid bias towards excessively long sentences
        const normalizedScore = sWords.length > 0 ? sScore / Math.sqrt(sWords.length) : 0;
        if (normalizedScore > highestScore) {
          highestScore = normalizedScore;
          bestSentence = s;
        }
      }

      document.getElementById('summaryText').innerText = `"${bestSentence}"`;

      // 5. Keyword Extraction (Top TF Words)
      const sortedKeywords = Object.entries(wordFreq).sort((a, b) => b[1] - a[1]).slice(0, 6);
      const kwList = document.getElementById('keywordsList');
      if (sortedKeywords.length === 0) {
        kwList.innerHTML = `<span style="color:var(--text-muted); font-size:0.85rem;">No significant keywords found.</span>`;
      } else {
        kwList.innerHTML = sortedKeywords.map(([term, count]) => `
          <div class="keyword-tag">
            <span>#${term}</span>
            <span class="keyword-weight">(${count})</span>
          </div>
        `).join('');
      }
    }

    // Run initially with default tech sample
    loadSample('tech');
  </script>
</body>
</html>
